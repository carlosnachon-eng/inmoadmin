# Supabase público: requerido por el cliente web.
# Cada ambiente debe apuntar a su propio proyecto Supabase.
# Local/Preview no deben usar las llaves de Producción.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_ENV=preview
NEXT_PUBLIC_FASE_2A_ENABLED=false

# Supabase privilegiado: solo para rutas API del servidor.
# En Preview debe ser el service role del proyecto DEV/PREVIEW.
SUPABASE_SERVICE_ROLE_KEY=
APP_ENV=preview
SUPABASE_ENVIRONMENT=dev
FASE_2A_ENABLED=false

# URL base del ambiente actual.
# Local: http://localhost:3000
# Producción: https://app.emporioinmobiliario.com.mx
NEXT_PUBLIC_APP_URL=

# Protección de endpoints ejecutados por Vercel Cron.
CRON_SECRET=

# Correo transaccional.
RESEND_API_KEY=

# Integraciones externas.
ANTHROPIC_API_KEY=
DIDIT_API_KEY=
EASYBROKER_API_KEY=
GOOGLE_SERVICE_ACCOUNT=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Respond.io Fase 2A: solo servidor. Configurar por entorno.
RESPOND_IO_API_TOKEN=
RESPOND_IO_WORKSPACE_ID=
RESPOND_IO_PROFILE_MAP={}
